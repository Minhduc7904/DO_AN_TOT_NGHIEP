COMPOSE_PROJECT_NAME=aiops-lms

GATEWAY_PORT=3000
GATEWAY_SERVICE_INSTANCE_ID=gateway-compose-1
GATEWAY_SERVICE_VERSION=0.1.0
GATEWAY_UPSTREAM_TIMEOUT_MS=5000

COURSE_PORT=3003
COURSE_SERVICE_INSTANCE_ID=course-compose-1
COURSE_SERVICE_VERSION=0.1.0
COURSE_MEDIA_TIMEOUT_MS=3000

MEDIA_PORT=3004
MEDIA_WORKER_PORT=3005
MEDIA_SERVICE_INSTANCE_ID=media-compose-1
MEDIA_WORKER_SERVICE_INSTANCE_ID=media-worker-compose-1
MEDIA_SERVICE_VERSION=0.1.0
# Địa chỉ MinIO mà trình duyệt truy cập được (ký presigned POST cho upload trực tiếp).
MINIO_PUBLIC_URL=http://localhost:9000
MEDIA_UPLOAD_EXPIRES_SECONDS=900
MEDIA_MULTIPART_MAX_BYTES=26214400
MEDIA_STUDENT_TIMEOUT_MS=3000
MEDIA_WORKER_PREFETCH=4
MEDIA_WORKER_MAX_ATTEMPTS=5
MEDIA_WORKER_RETRY_DELAY_MS=1000
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

NOTIFICATION_PORT=3006
NOTIFICATION_GRADE_COMPLETED_EXCHANGE=lms.events
NOTIFICATION_GRADE_COMPLETED_QUEUE=notification.grade-completed.v1
NOTIFICATION_CONSUMER_PREFETCH=1
NOTIFICATION_RECONNECT_DELAY_MS=1000
NOTIFICATION_DEDUP_TTL_SECONDS=86400
NOTIFICATION_DEDUP_MAX_EVENT_IDS=10000
NOTIFICATION_CONSUMER_SLOWDOWN_ENABLED=false
NOTIFICATION_CONSUMER_SLOWDOWN_MS=0
NOTIFICATION_SERVICE_INSTANCE_ID=notification-compose-1
NOTIFICATION_SERVICE_VERSION=0.1.0

AUTH_PORT=3001
AUTH_SERVICE_INSTANCE_ID=auth-compose-1
AUTH_SERVICE_VERSION=0.1.0
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth-local-only
# Khóa ký Ed25519 (PKCS8 PEM một dòng, xuống dòng viết \n). Để trống: khóa tạm mỗi lần khởi động.
# Sinh khóa: node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).replaceAll('\n','\\n'))"
AUTH_SIGNING_KEY_PEM=
# Testbed cục bộ cho phép khóa tạm (NODE_ENV=production trong container); đặt false khi dùng khóa cố định.
AUTH_ALLOW_EPHEMERAL_SIGNING_KEY=true
AUTH_SERVICE_TOKEN_TTL_SECONDS=600
# Secret client dịch vụ (client-credentials); đổi cả hai khi triển khai thật.
GATEWAY_CLIENT_SECRET=gateway-client-local-only
AUTH_CLIENT_SECRET=auth-client-local-only
COURSE_CLIENT_SECRET=course-client-local-only
MEDIA_CLIENT_SECRET=media-client-local-only
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=86400

STUDENT_PORT=3012
STUDENT_SERVICE_INSTANCE_ID=student-compose-1
STUDENT_SERVICE_VERSION=0.1.0
# Role và mật khẩu Postgres cho từng service v2 (mặc định <service>_user / <service>-local-only).
STUDENT_POSTGRES_USER=student_user
STUDENT_POSTGRES_PASSWORD=student-local-only
COURSE_POSTGRES_USER=course_user
COURSE_POSTGRES_PASSWORD=course-local-only
MEDIA_POSTGRES_USER=media_user
MEDIA_POSTGRES_PASSWORD=media-local-only

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=lms-minio
MINIO_ROOT_PASSWORD=lms-minio-local-only

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms-local-only


RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=lms
RABBITMQ_DEFAULT_PASS=lms-local-only

# Tên network dùng chung với aiops-platform/observability (khai báo cùng giá trị ở file .env bên đó).
AIOPS_NETWORK_NAME=aiops-net

OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
OTEL_METRIC_EXPORT_INTERVAL=5000
HTTP_ACCESS_LOG_ENABLED=true
