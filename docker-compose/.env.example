COMPOSE_PROJECT_NAME=aiops-lms

GATEWAY_PORT=3000
GATEWAY_SERVICE_INSTANCE_ID=gateway-compose-1
GATEWAY_SERVICE_VERSION=0.1.0
GATEWAY_UPSTREAM_TIMEOUT_MS=5000

COURSE_PORT=3002
COURSE_CACHE_TTL_SECONDS=60
COURSE_CACHE_TIMEOUT_MS=300
COURSE_SERVICE_INSTANCE_ID=course-compose-1
COURSE_SERVICE_VERSION=0.1.0
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

ENROLLMENT_PORT=3003
ENROLLMENT_COURSE_TIMEOUT_MS=3000
ENROLLMENT_COURSE_BREAKER_THRESHOLD=3
ENROLLMENT_COURSE_BREAKER_COOLDOWN_MS=5000
ENROLLMENT_SERVICE_INSTANCE_ID=enrollment-compose-1
ENROLLMENT_SERVICE_VERSION=0.1.0

AUTH_PORT=3001
AUTH_SERVICE_INSTANCE_ID=auth-compose-1
AUTH_SERVICE_VERSION=0.1.0
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth-local-only
AUTH_JWT_SECRET=local-development-only-jwt-secret-change-before-production
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=86400

POSTGRES_PORT=5432
POSTGRES_DB=course_db
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms-local-only

REDIS_PORT=6379

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=lms
RABBITMQ_DEFAULT_PASS=lms-local-only
