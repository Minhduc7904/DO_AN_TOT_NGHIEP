{
  "uid": "aiops-lms-service-overview",
  "title": "AIOps LMS — Service overview",
  "description": "RED theo service/route, dependency, broker backlog, trace lỗi và log; nối metric → trace → log theo trace_id.",
  "tags": ["aiops-lms", "w10", "observability"],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_count_total{service_name!=\"submission-storage\"}, service_name)",
          "refId": "service"
        },
        "definition": "label_values(http_server_request_count_total{service_name!=\"submission-storage\"}, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RED theo service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Request/giây theo service, không gồm /health.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Trace của ${__field.labels.service_name}",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "refId": "A",
                  "queryType": "traceql",
                  "query": "{ resource.service.name = \"${__field.labels.service_name}\" && kind = server }",
                  "limit": 20
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_count_total{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error ratio",
      "description": "Tỷ lệ HTTP 5xx/client_aborted trên tổng request theo service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Trace lỗi của ${__field.labels.service_name}",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "refId": "A",
                  "queryType": "traceql",
                  "query": "{ resource.service.name = \"${__field.labels.service_name}\" && kind = server && status = error }",
                  "limit": 20
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (service_name) (rate(http_server_request_error_count_total{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval])) / sum by (service_name) (rate(http_server_request_count_total{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval]))) or (0 * sum by (service_name) (rate(http_server_request_count_total{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "p95 thời gian xử lý HTTP theo service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Trace chậm của ${__field.labels.service_name}",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "refId": "A",
                  "queryType": "traceql",
                  "query": "{ resource.service.name = \"${__field.labels.service_name}\" && kind = server } | duration > 500ms",
                  "limit": 20
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "RED theo route",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate theo route và status class",
      "description": "Route là template bounded, không chứa ID.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Trace ${__field.labels.http_method} ${__field.labels.http_route_template}",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "refId": "A",
                  "queryType": "traceql",
                  "query": "{ resource.service.name = \"${__field.labels.service_name}\" && span.http.route = \"${__field.labels.http_route_template}\" }",
                  "limit": 20
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name, http_method, http_route_template, http_status_class) (rate(http_server_request_count_total{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{http_method}} {{http_route_template}} {{http_status_class}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p95 theo route",
      "description": "p95 thời gian xử lý HTTP theo service/route.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
