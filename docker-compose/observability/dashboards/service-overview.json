      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "links": [
            {
              "title": "Trace ${__field.labels.http_method} ${__field.labels.http_route_template}",
              "url": "",
              "internal": {
                "datasourceUid": "tempo",
                "datasourceName": "Tempo",
                "query": {
                  "refId": "A",
                  "queryType": "traceql",
                  "query": "{ resource.service.name = \"${__field.labels.service_name}\" && span.http.route = \"${__field.labels.http_route_template}\" }",
                  "limit": 20
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, http_method, http_route_template, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",http_route_template!=\"/health\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{http_method}} {{http_route_template}}",
          "range": true
