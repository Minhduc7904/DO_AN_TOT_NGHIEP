NODE_ENV=development
PORT=3000
GATEWAY_JWT_SECRET=local-development-only-jwt-secret-change-before-production
GATEWAY_UPSTREAM_TIMEOUT_MS=30000
GATEWAY_AUTH_BASE_URL=http://localhost:3001
GATEWAY_STUDENT_BASE_URL=http://localhost:3002
GATEWAY_COURSE_BASE_URL=http://localhost:3003
GATEWAY_MEDIA_BASE_URL=http://localhost:3004
GATEWAY_NOTIFICATION_BASE_URL=http://localhost:3005
GATEWAY_SCHEDULER_BASE_URL=http://localhost:3006
GATEWAY_AI_BASE_URL=http://localhost:3007
# Route v1 tạm thời cho tới R-05; bỏ trống thì route không tồn tại.
# GATEWAY_ENROLLMENT_BASE_URL=http://localhost:3008
# GATEWAY_SUBMISSION_BASE_URL=http://localhost:3009
# GATEWAY_GRADING_BASE_URL=http://localhost:3010
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
