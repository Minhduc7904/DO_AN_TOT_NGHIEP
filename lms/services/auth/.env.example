NODE_ENV=development
PORT=3001
AUTH_DATABASE_URL=postgresql://auth_user:auth-local-only@localhost:5432/auth_db
AUTH_JWT_SECRET=local-development-only-jwt-secret-change-before-production
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=86400
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_INSTANCE_ID=auth-local-1
AUTH_STUDENT_BASE_URL=http://localhost:3002
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
AUTH_BOOTSTRAP_ADMIN_PASSWORD=example-password
AUTH_BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@example.test
AUTH_BOOTSTRAP_INSTRUCTOR_PASSWORD=example-password
