NODE_ENV=development
PORT=3001
AUTH_DATABASE_URL=postgresql://auth_user:auth-local-only@localhost:5432/auth_db
# Khóa ký Ed25519 (PKCS8 PEM một dòng, xuống dòng viết \n). Để trống: khóa tạm mỗi lần khởi động.
AUTH_SIGNING_KEY_PEM=
AUTH_SERVICE_TOKEN_TTL_SECONDS=600
# Danh tính của chính auth khi gọi student, và registry client dịch vụ (ADR-004).
SERVICE_CLIENT_ID=auth
SERVICE_CLIENT_SECRET=auth-client-local-only
SERVICE_CLIENTS_BOOTSTRAP=[{"client_id":"gateway","client_secret":"gateway-client-local-only","audiences":["auth","student","course"],"scopes":["gateway:proxy"]},{"client_id":"auth","client_secret":"auth-client-local-only","audiences":["student"],"scopes":["student:profile:read","student:profile:write"]}]
AUTH_JWT_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=86400
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_INSTANCE_ID=auth-local-1
AUTH_STUDENT_BASE_URL=http://localhost:3002
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
AUTH_BOOTSTRAP_ADMIN_PASSWORD=example-password
AUTH_BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@example.test
AUTH_BOOTSTRAP_INSTRUCTOR_PASSWORD=example-password
