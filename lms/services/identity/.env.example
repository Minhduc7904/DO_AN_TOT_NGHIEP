NODE_ENV=development
PORT=3001
IDENTITY_DATABASE_URL=postgresql://identity_user:identity-local-only@localhost:5432/identity_db
# Khóa ký Ed25519 (PKCS8 PEM một dòng, xuống dòng viết \n). Để trống: khóa tạm mỗi lần khởi động.
IDENTITY_SIGNING_KEY_PEM=
IDENTITY_SERVICE_TOKEN_TTL_SECONDS=600
# Registry client dịch vụ được xin token (ADR-004); audience của service này là `identity`.
SERVICE_CLIENTS_BOOTSTRAP=[{"client_id":"gateway","client_secret":"gateway-client-local-only","audiences":["identity","course"],"scopes":["gateway:proxy"]},{"client_id":"media","client_secret":"media-client-local-only","audiences":["identity"],"scopes":["student:profile:read"]}]
IDENTITY_JWT_TTL_SECONDS=3600
IDENTITY_REFRESH_TTL_SECONDS=86400
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_INSTANCE_ID=identity-local-1
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=example-password
IDENTITY_BOOTSTRAP_INSTRUCTOR_EMAIL=instructor@example.test
IDENTITY_BOOTSTRAP_INSTRUCTOR_PASSWORD=example-password
