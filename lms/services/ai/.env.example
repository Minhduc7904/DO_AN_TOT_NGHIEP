NODE_ENV=development
PORT=3009
AI_DATABASE_URL=postgresql://ai_user:ai-local-only@localhost:5432/ai_db
# Khóa AES-256 (base64 của đúng 32 byte) mã hóa API key của provider. Sinh bằng: openssl rand -base64 32
# Ví dụ dưới đây chỉ dành cho máy local; mất hoặc đổi khóa thì mọi API key đã lưu không giải mã được.
AI_ENCRYPTION_KEY=bG9jYWwtb25seS1haS1lbmNyeXB0aW9uLWtleS0zMmI=
AI_COMPLETION_TIMEOUT_MS=240000
AI_HEALTH_CHECK_TIMEOUT_MS=6000
AUTH_BASE_URL=http://localhost:3001
# RabbitMQ (outbox relay của API và consumer của ai-worker)
AI_RABBITMQ_URL=amqp://lms:lms-local-only@localhost:5672
AI_OUTBOX_POLL_MS=500
# --- Chỉ ai-worker (node dist/worker.js, PORT=3011) ---
# SERVICE_CLIENT_ID=ai-worker
# SERVICE_CLIENT_SECRET=ai-worker-client-secret-local-only
# AI_COURSE_BASE_URL=http://localhost:3003
# AI_MEDIA_BASE_URL=http://localhost:3004
# AI_WORKER_PREFETCH=2
# AI_WORKER_MAX_ATTEMPTS=5
# AI_WORKER_RETRY_DELAY_MS=1000
# Lease job/tài liệu phải lớn hơn AI_COMPLETION_TIMEOUT_MS
# AI_WORKER_LEASE_MS=600000
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_VERSION=0.1.0
OTEL_SERVICE_INSTANCE_ID=ai-local-1
