              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": \"{{course_id}}\"\n}"
            },
            "url": "{{gateway_base_url}}/api/v1/enrollments"
          }
        },
        {
          "name": "List My Enrollments - Student",
          "event": [
