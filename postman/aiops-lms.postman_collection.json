    {
      "name": "08 - Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": { "method": "GET", "url": "{{gateway_base_url}}/health" }
        },
        {
          "name": "Auth Health",
          "request": { "method": "GET", "url": "{{auth_base_url}}/health" }
        },
        {
          "name": "Course Health",
          "request": { "method": "GET", "url": "{{course_base_url}}/health" }
        },
        {
          "name": "Enrollment Health",
          "request": {
            "method": "GET",
            "url": "{{enrollment_base_url}}/health"
          }
        },
        {
          "name": "Submission Health",
          "request": {
            "method": "GET",
            "url": "{{submission_base_url}}/health"
          }
        },
        {
          "name": "Storage Mock Health",
          "request": { "method": "GET", "url": "{{storage_base_url}}/health" }
        },
        {
          "name": "Notification Health",
          "request": {
            "method": "GET",
            "url": "{{notification_base_url}}/health"
