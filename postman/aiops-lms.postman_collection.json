              ]
            },
            "method": "GET",
            "url": "{{gateway_base_url}}/api/v1/enrollments?limit={{limit}}"
          }
        },
        {
          "name": "List Enrollments By Course - Instructor",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{instructor_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{gateway_base_url}}/api/v1/enrollments?course_id={{course_id}}&limit={{limit}}"
