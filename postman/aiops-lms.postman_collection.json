    {
      "name": "07 - Storage Mock",
      "item": [
        {
          "name": "Put Object",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const data = pm.response.json(); if (data.object_key) pm.environment.set('storage_object_key', data.object_key); }"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"{{storage_content}}\"\n}"
            },
            "url": "{{storage_base_url}}/api/v1/objects/{{storage_object_key}}"
          }
        },
        {
          "name": "Get Object",
          "request": {
            "method": "GET",
            "url": "{{storage_base_url}}/api/v1/objects/{{storage_object_key}}"
          }
