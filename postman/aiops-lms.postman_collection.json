  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const required = ['gateway_base_url', 'auth_base_url', 'course_base_url', 'enrollment_base_url', 'submission_base_url', 'storage_base_url', 'notification_base_url', 'grading_base_url'];",
          "required.forEach((key) => { if (!pm.environment.get(key)) console.warn(`Thieu bien environment: ${key}`); });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  let data;",
          "  try { data = pm.response.json(); } catch (_) { data = null; }",
          "  if (data && typeof data === 'object') {",
          "    const path = pm.request.url.getPath();",
          "    const first = Array.isArray(data.items) && data.items.length > 0 ? data.items[0] : data;",
          "    if (data.access_token) pm.environment.set('access_token', data.access_token);",
          "    if (data.refresh_token) pm.environment.set('refresh_token', data.refresh_token);",
          "    if (data.principal && data.principal.id) {",
          "      pm.environment.set('principal_id', data.principal.id);",
          "      pm.environment.set('principal_role', data.principal.role);",
          "      pm.environment.set(`${data.principal.role}_id`, data.principal.id);",
          "      if (data.access_token) pm.environment.set(`${data.principal.role}_access_token`, data.access_token);",
          "      if (data.refresh_token) pm.environment.set(`${data.principal.role}_refresh_token`, data.refresh_token);",
          "    }",
          "    if (first && first.id) {",
          "      if (path.includes('/courses')) pm.environment.set('course_id', first.id);",
          "      if (path.includes('/enrollments')) pm.environment.set('enrollment_id', first.id);",
          "      if (path.includes('/submissions')) pm.environment.set('submission_id', first.id);",
          "      if (path.includes('/grades')) pm.environment.set('grade_id', first.id);",
          "    }",
          "    if (first && first.course_id) pm.environment.set('course_id', first.course_id);",
          "    if (first && first.principal_id && path.includes('/enrollments')) pm.environment.set('student_id', first.principal_id);",
          "    if (first && first.submission_id) pm.environment.set('submission_id', first.submission_id);",
          "    if (first && first.storage_object_key) pm.environment.set('storage_object_key', first.storage_object_key);",
          "    if (data.object_key) pm.environment.set('storage_object_key', data.object_key);",
          "  }",
          "}"
        ]
      }
    }
  ]
}
