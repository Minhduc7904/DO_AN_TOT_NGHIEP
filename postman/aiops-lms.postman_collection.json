            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"error_mode\": \"{{fault_error_mode}}\",\n  \"latency_ms\": {{fault_latency_ms}}\n}"
            },
            "url": "{{storage_base_url}}/internal/v1/fault"
          }
        },
        {
          "name": "Reset Fault",
          "request": {
            "method": "DELETE",
            "url": "{{storage_base_url}}/internal/v1/fault"
          }
        },
