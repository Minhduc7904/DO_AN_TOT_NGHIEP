{
  "info": {
    "_postman_id": "b2607c08-a205-48b1-b592-05fd5856bfa8",
    "name": "AIOps LMS - Complete API",
    "description": "Toan bo HTTP API cua AIOps LMS. Import kem environment `AIOps LMS - Local`. Cac request login va tao tai nguyen tu dong cap nhat token/ID vao environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication (Gateway)",
      "item": [
        {
          "name": "Login - Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dang nhap student thanh cong', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('access_token', data.access_token);",
                  "  pm.environment.set('refresh_token', data.refresh_token);",
                  "  pm.environment.set('student_access_token', data.access_token);",
                  "  pm.environment.set('student_refresh_token', data.refresh_token);",
                  "  pm.environment.set('principal_id', data.principal.id);",
                  "  pm.environment.set('principal_role', data.principal.role);",
                  "  pm.environment.set('student_id', data.principal.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}"
            },
            "url": "{{gateway_base_url}}/api/v1/auth/student/login",
            "description": "Dang nhap student va tu dong luu token, refresh token, principal ID/role."
          }
        },
        {
          "name": "Login - Instructor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dang nhap instructor thanh cong', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('access_token', data.access_token);",
                  "  pm.environment.set('refresh_token', data.refresh_token);",
                  "  pm.environment.set('instructor_access_token', data.access_token);",
                  "  pm.environment.set('instructor_refresh_token', data.refresh_token);",
                  "  pm.environment.set('principal_id', data.principal.id);",
                  "  pm.environment.set('principal_role', data.principal.role);",
                  "  pm.environment.set('instructor_id', data.principal.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{instructor_email}}\",\n  \"password\": \"{{instructor_password}}\"\n}"
            },
            "url": "{{gateway_base_url}}/api/v1/auth/instructor/login",
            "description": "Dang nhap instructor va tu dong luu token, refresh token, principal ID/role."
          }
        },
        {
          "name": "Refresh Current Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh token thanh cong', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.environment.set('access_token', data.access_token);",
                  "  pm.environment.set('refresh_token', data.refresh_token);",
                  "  const role = pm.environment.get('principal_role');",
                  "  if (role === 'student') { pm.environment.set('student_access_token', data.access_token); pm.environment.set('student_refresh_token', data.refresh_token); }",
                  "  if (role === 'instructor') { pm.environment.set('instructor_access_token', data.access_token); pm.environment.set('instructor_refresh_token', data.refresh_token); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{gateway_base_url}}/api/v1/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "02 - Courses (Gateway)",
      "item": [
        {
          "name": "Create Course - Instructor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tao course thanh cong', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) { const data = pm.response.json(); if (data.id) pm.environment.set('course_id', data.id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{instructor_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{course_title}}\"\n}"
            },
            "url": "{{gateway_base_url}}/api/v1/courses"
          }
        },
        {
          "name": "List Courses",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lay danh sach course thanh cong', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const data = pm.response.json(); if (data.items && data.items[0] && data.items[0].id) pm.environment.set('course_id', data.items[0].id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{gateway_base_url}}/api/v1/courses?limit={{limit}}"
          }
        },
        {
          "name": "Get Course By ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{student_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{gateway_base_url}}/api/v1/courses/{{course_id}}"
          }
        }
      ]
    },
    {
