# Dependency, build output và cấu hình local của LMS workspace.
lms/**/node_modules/
lms/**/.pnpm-store/
lms/**/dist/
lms/**/coverage/
lms/**/*.tsbuildinfo
lms/**/.env
lms/**/.env.*
!lms/**/.env.example
lms/**/*.log
lms/**/.eslintcache

# Cấu hình local của Docker Compose root.
docker-compose/.env
docker-compose/.env.*
!docker-compose/.env.example

# Cấu hình local của stack observability trong aiops-platform.
aiops-platform/**/.env
aiops-platform/**/.env.*
!aiops-platform/**/.env.example

# Dữ liệu tạm do Codex tạo khi kiểm chứng hoặc render cục bộ.
/.codex-tmp/
